# Azure OpenAI (Slice 3+). Leave blank to use the mock explain client.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# auto | mock | azure  (auto → azure when endpoint+key set, else mock)
EXPLAIN_PROVIDER=auto

# App
INSIGHTS_API_HOST=0.0.0.0
INSIGHTS_API_PORT=8000
SYNTHETIC_FIXTURE_PATH=../../data/synthetic/sample_match.json
