{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "studio-web": {
      "root": "apps/studio-web/",
      "framework": "nextjs"
    },
    "insights-api": {
      "root": "services/insights-api/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "insights-api" }
    },
    {
      "source": "/health",
      "destination": { "service": "insights-api" }
    },
    {
      "source": "/docs",
      "destination": { "service": "insights-api" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "insights-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "studio-web" }
    }
  ]
}
