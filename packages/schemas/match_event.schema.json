{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insidethegame.local/schemas/match_event.schema.json",
  "title": "SyntheticMatchEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "match_id",
    "seq",
    "match_clock",
    "period",
    "type",
    "ts"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "match_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "match_clock": {
      "type": "string",
      "pattern": "^[0-9]{1,3}:[0-5][0-9]$",
      "description": "Match clock mm:ss (may exceed 90 for stoppage demos)"
    },
    "period": { "type": "integer", "enum": [1, 2] },
    "type": {
      "type": "string",
      "enum": [
        "pass",
        "shot",
        "tackle",
        "possession_change",
        "pressure",
        "metadata",
        "foul",
        "card",
        "substitution",
        "goal"
      ]
    },
    "team_id": { "type": ["string", "null"] },
    "player_id": { "type": ["string", "null"] },
    "actors": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["role"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string" },
          "player_id": { "type": ["string", "null"] },
          "team_id": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] }
        }
      }
    },
    "payload": { "type": "object" },
    "ts": { "type": "string", "format": "date-time" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Same instant as ts (Slice 1 acceptance alias)"
    },
    "synthetic": {
      "type": "boolean",
      "const": true,
      "default": true
    }
  }
}
