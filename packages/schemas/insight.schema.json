{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insidethegame.local/schemas/insight.schema.json",
  "title": "MatchInsight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "insight_id",
    "match_id",
    "match_clock",
    "duration_ms",
    "priority",
    "overlay_type",
    "headline",
    "body",
    "why_it_matters",
    "evidence"
  ],
  "properties": {
    "insight_id": { "type": "string", "format": "uuid" },
    "match_id": { "type": "string" },
    "match_clock": { "type": "string" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "priority": { "type": "string", "enum": ["low", "medium", "high"] },
    "overlay_type": {
      "type": "string",
      "enum": ["lower_third", "moment_card", "recap_block", "ticker"]
    },
    "headline": { "type": "string" },
    "body": { "type": "string" },
    "why_it_matters": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "label"],
        "properties": {
          "event_id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["player", "club", "team"] },
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "trigger": { "type": ["string", "null"] },
    "source_event_seq": { "type": ["integer", "null"] },
    "provider": { "type": "string", "enum": ["azure_openai", "mock"] },
    "synthetic": { "type": "boolean", "const": true }
  }
}
